ENABLE_DEV_AUTH=true
ENABLE_DEV_ASSESSMENTS=true
EXECUTION_PROVIDER=docker-local
LOCAL_RUNNER_IMAGE=university-simulator-runner:local
LOCAL_DATA_DIR=/srv/university-simulator/state/data
PORT=33101
