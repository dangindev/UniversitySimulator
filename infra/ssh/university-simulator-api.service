[Unit]
Description=University Simulator private internal API
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=university-simulator
Group=university-simulator
SupplementaryGroups=docker
WorkingDirectory=/srv/university-simulator/current/apps/api
EnvironmentFile=/srv/university-simulator/state/runtime.env
Environment=PATH=/opt/university-simulator-runtime/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/university-simulator-runtime/bin/node --import tsx src/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/university-simulator/state
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=2G
TasksMax=192

[Install]
WantedBy=multi-user.target
