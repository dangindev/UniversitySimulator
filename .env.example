# Local-only development. Never enable these two flags on public hosting.
NODE_ENV=development
PORT=3001
ENABLE_DEV_AUTH=true
ENABLE_DEV_ASSESSMENTS=true
LOCAL_DATA_DIR=../../.data
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Public client configuration (Supabase publishable/anon key, never service_role).
VITE_API_URL=/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production service configuration. Obtain from your service dashboards.
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
REDIS_URL=
E2B_API_KEY=
E2B_TEMPLATE_ID=
ASSESSMENT_BANK_PATH=
CONTENT_MANIFEST_PATH=
# Conservative maximum billable VM seconds, including compile/cleanup overhead.
# Recalibrate against provider rates before production; the design allocation is 4M VND/month.
EXECUTION_MONTHLY_SECONDS=1000000
