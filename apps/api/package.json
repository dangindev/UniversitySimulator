    "@university-simulator/core": "0.1.0",
    "@university-simulator/content": "0.1.0",
    "bullmq": "^5.71.0",
    "dotenv": "^17.2.3",
    "e2b": "2.62.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.0.0",
    "jose": "^6.1.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
