{
  "name": "university-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @university-simulator/api\" \"npm run dev -w @university-simulator/web\"",
    "dev:web": "npm run dev -w @university-simulator/web",
    "dev:api": "npm run dev -w @university-simulator/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "readiness": "tsx scripts/readiness.ts",
    "test:load": "tsx scripts/load-smoke.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2", "@nestjs/core": "^12.3.2", "@nestjs/platform-express": "^12.3.2", "@nestjs/swagger": "^12.0.0",
    "@supabase/supabase-js": "^2.99.0", "bullmq": "^5.0.0", "e2b": "^2.62.0", "helmet": "^8.0.0", "ioredis": "^5.0.0", "jose": "^6.0.0",
    "dotenv": "^17.2.3", "lucide-react": "^0.577.0", "pg": "^8.0.0", "phaser": "3.90.0", "react": "19.3.1", "react-dom": "19.3.1", "reflect-metadata": "^0.2.2", "rxjs": "^7.8.2", "zod": "^4.0.0"
  },
  "overrides": { "glob": "14.0.3", "minimatch": "11.0.3" },
  "devDependencies": {
    "@types/express": "^5.0.0", "@types/node": "^24.0.0", "@types/pg": "^8.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0", "concurrently": "^9.0.0", "tsx": "^4.0.0", "typescript": "6.0.3", "vite": "8.3.5", "vitest": "^4.0.0"
  }
}
